# Cloudflare Pages redirects.
# Format: <from>  <to>  <status>
# Used to:
#   1) Preserve SEO from URLs indexed on the WordPress site that don't map 1:1
#   2) Tell Pages to fall back to index.html for SPA routes (last rule)

# WordPress page slugs → our routes (301 to transfer link equity)
/about-us-2/             /about         301
/about-us-2              /about         301
/contact-us/             /contact       301
/contact-us              /contact       301
/my-account/             /              301
/my-account              /              301

# Legal pages — point to home until dedicated pages exist
/privacy-policy/         /              301
/privacy-policy          /              301
/shipping-policy/        /              301
/shipping-policy         /              301
/terms-and-conditions/   /              301
/terms-and-conditions    /              301

# SPA fallback — serve index.html with 200 for any path that doesn't match a
# pre-rendered static file (e.g. /checkout, /cart, /track, /admin/*).
# Cloudflare Pages evaluates _redirects AFTER matching real files, so static
# assets (JS, CSS, images) are still served directly — this only fires for
# unmatched paths.
/* /index.html 200
